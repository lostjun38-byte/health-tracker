{
  "name": "health-tracker",
  "private": true,
  "version": "1.0.0",
  "description": "个人健康打卡与运动记录 —— 本地优先、注重隐私的 Vue 单页应用",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "check": "npm run lint && npm test && npm run test:e2e"
  },
  "dependencies": {
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "eslint": "^10.10.0",
    "eslint-plugin-vue": "^10.11.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^16.5.0",
    "vite": "^6.0.7",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24"
  }
}
